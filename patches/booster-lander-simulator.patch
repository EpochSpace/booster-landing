+
+/* --- RTLS handover patch (booster-landing) ------------------------------------------------
+ * The shipped scenarios all start with essentially zero horizontal velocity: scenario_init
+ * gives S_VX/S_VY a +-5 m/s dispersion and nothing else. A stage handed over at the entry
+ * interface after a boostback burn is still flying back towards the pad at a couple of
+ * hundred m/s, so there was no way to express its initial state. SCEN_CUSTOM adds one
+ * scenario whose initial conditions -- including that horizontal velocity -- come from the
+ * command line: `--custom "h0=70000,vx0=-205,vz0=-1360,lateral=9083,prop0=29067,retro=1"`.
+ * Keys: h0 vz0 vx0 lateral prop0 tilt0 uref deck w20 fins retro. Returns 0 on a bad spec.
+ * `retro=1` points the stage along its own retrograde velocity instead of near-vertical,
+ * which is the attitude a returning booster actually arrives in. */
+int scenario_set_custom(const char* spec);
 /* Initialize state + environment for (scenario, seed, run_idx). run_idx=0 => nominal (no dispersion). */
 void scenario_init(State* st, int scen, uint32_t seed, uint32_t run_idx, ScenarioEnv* se);
 
