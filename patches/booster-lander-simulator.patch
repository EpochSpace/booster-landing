+int scenario_set_custom(const char* spec){
+    if(!spec) return 0;
+    char buf[1024]; size_t n=strlen(spec);
+    if(n>=sizeof(buf)) return 0;
+    memcpy(buf,spec,n+1);
+    for(char* tok=strtok(buf,",");tok;tok=strtok(0,",")){
+        char* eq=strchr(tok,'=');
+        if(!eq) return 0;
+        *eq=0;
+        const char* k=tok; double v=strtod(eq+1,0);
+        if(!strcmp(k,"h0"))           CUSTOM.h0=v;
+        else if(!strcmp(k,"vz0"))     CUSTOM.vz0=v;
+        else if(!strcmp(k,"vx0"))     CUSTOM.vx0=v;
+        else if(!strcmp(k,"lateral")) CUSTOM.lateral=v;
+        else if(!strcmp(k,"prop0"))   CUSTOM.prop0=v;
+        else if(!strcmp(k,"tilt0"))   CUSTOM.tilt0=v*DEG2RAD;
+        else if(!strcmp(k,"uref"))    CUSTOM.u_ref=v;
+        else if(!strcmp(k,"deck"))    CUSTOM.deck_z=v;
+        else if(!strcmp(k,"w20"))     CUSTOM.w20=(int)v;
+        else if(!strcmp(k,"fins"))    CUSTOM.fins=(int)v;
+        else if(!strcmp(k,"retro"))   CUSTOM.retro=(int)v;
+        else return 0;
+    }
+    return 1;
+}
